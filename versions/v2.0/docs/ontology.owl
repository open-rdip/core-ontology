            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ontology/bibo/oclcnum"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>Collection of information resources that have a unified identity. Archives, museums and libraries often acquire collections on specific subjects and from distinguished authors or researchers. Also includes collections of resources bundled into a license.</obo:IAO_0000112>
        <obo:IAO_0000112>Hill Ornithology Collection; Wiley Interscience Online Books Biochemisty Collection</obo:IAO_0000112>
        <obo:IAO_0000115>Collection of information resources that have a unified identity</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A collection of Documents or Collections</rdfs:comment>
