        <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Collection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
