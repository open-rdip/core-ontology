    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ERO_0001259 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ERO_0001259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ERO_0001258"/>
