        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115>A service offering that describes a service in which the provider actively maintains a material or data resource (e.g. a model organism colony or database) for the service consumer.  This may involved making physical alterations to the material or data with the goal of maintaining its integrity or features.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Matt Brush</obo:IAO_0000117>
        <obo:IAO_0000119>PERSON: Matthew Brush</obo:IAO_0000119>
