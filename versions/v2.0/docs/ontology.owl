    <!-- http://purl.org/ontology/bibo/Standard -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Standard">
        <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Specification"/>
        <obo:IAO_0000112>Short Definition from OCLC Input Standards, EntW</obo:IAO_0000112>
