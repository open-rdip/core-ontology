    <!-- http://aims.fao.org/aos/geopolitical.owl#economic_region -->


    <owl:Class rdf:about="http://aims.fao.org/aos/geopolitical.owl#economic_region">
        <rdfs:subClassOf rdf:resource="http://aims.fao.org/aos/geopolitical.owl#group"/>
        <rdfs:label xml:lang="en">Economic Region</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/geopolitical.owl#geographical_region -->


    <owl:Class rdf:about="http://aims.fao.org/aos/geopolitical.owl#geographical_region">
        <rdfs:subClassOf rdf:resource="http://aims.fao.org/aos/geopolitical.owl#group"/>
        <rdfs:subClassOf rdf:resource="http://vivoweb.org/ontology/core#GeographicRegion"/>
        <terms:source>United Nations statistics department http://unstats.un.org/unsd/methods/m49/m49regin.htm</terms:source>
        <rdfs:label xml:lang="en">Transnational Region</rdfs:label>
    </owl:Class>
    


