                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <obo:IAO_0000112>020530902X</obo:IAO_0000112>
        <obo:IAO_0000112>Amazon standard identification number. Source: http://en.wikipedia.org/wiki/Amazon_Standard_Identification_Number.</obo:IAO_0000112>
        <rdfs:comment xml:lang="en">Amazon Standard Identification Number</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.org/ontology/bibo/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Amazon Standard Identification Number (ASIN)</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/ontology/bibo/chapter -->


