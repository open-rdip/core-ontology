        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A maintenance service offering that describes a service in which the provider actively maintains a material resource (e.g. a model organism colony) for the service consumer.  A material maintenance service may or may not include storage of the material input.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Matt Brush</obo:IAO_0000117>
        <obo:IAO_0000119>PERSON: Matthew Brush</obo:IAO_0000119>
        <rdfs:label xml:lang="en">Material Maintenance Service</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ERO_0001260 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ERO_0001260">
