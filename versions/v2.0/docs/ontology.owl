                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>Methods in Molecular Biology</obo:IAO_0000112>
        <obo:IAO_0000115>A thematic collection of documents, usually books, issued at regular or irregular intervals</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A loose, thematic, collection of Documents, often Books.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.org/ontology/bibo/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Series</rdfs:label>
        <ns:term_status>stable</ns:term_status>
    </owl:Class>
    


