                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/ontology/bibo/Collection"/>
                            <rdf:Description rdf:about="http://purl.org/ontology/bibo/Document"/>
