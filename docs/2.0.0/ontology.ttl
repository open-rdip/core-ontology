                                                rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Encompasses talk, speech, lecture, slide lecture, conference presentation" ;
                                                rdfs:label "Presentation"@en .


