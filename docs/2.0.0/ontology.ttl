                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000112> "A specific academic journal article" ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Written by scholars for other scholars, typically published in an academic journal with an abstract and bibliography" ;
                                                rdfs:comment "A scholarly academic article, typically published in a journal."@en ;
                                                rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
                                                rdfs:label "Academic Article"@en ;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://purl.org/ontology/bibo/Article
<http://purl.org/ontology/bibo/Article> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ,
                                                        <https://schema.org/ScholarlyArticle> ,
