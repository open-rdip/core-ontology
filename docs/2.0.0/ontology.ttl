                                                              owl:allValuesFrom xsd:int
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "An employment activity, whether compensated or not. Short definition comes from http://en.wikipedia.org/wiki/Position, and has been modified." ,
                                                                                         "Director of Admissions and Placement; Associate University Librarian" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Particular position in an organization, commonly identified by job title, and normally associated with a job description that details the tasks and responsibilities that go with the position." ;
