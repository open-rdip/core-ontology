###  http://purl.org/ontology/bibo/Patent
<http://purl.org/ontology/bibo/Patent> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://vivoweb.org/ontology/core#dateIssued> ;
