                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A service offering that describes a service in which the consumer provides some input material or data and a service provider returns data about the input material or data." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: Matt Brush" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Matthew Brush" ;
