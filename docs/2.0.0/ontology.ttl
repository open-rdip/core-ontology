                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/ontology/bibo/pageStart> ;
                                                          owl:allValuesFrom rdfs:Literal
                                                        ] ;
                                        <http://purl.obolibrary.org/obo/IAO_0000112> "A specific journal article" ,
