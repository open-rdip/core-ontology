###  http://purl.org/net/OCRe/research.owl#Interventional_study
<http://purl.org/net/OCRe/research.owl#Interventional_study> rdf:type owl:Class .


###  http://purl.org/net/OCRe/study_design.owl#OCRE100038
<http://purl.org/net/OCRe/study_design.owl#OCRE100038> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                                                       <http://purl.obolibrary.org/obo/IAO_0000115> """Phase describes the level of a trial required of drugs before (and after) they are routinely used in clinical practice:
- Phase I trials assess toxic effects on humans (not many people participate in them, and usually without controls);
- Phase ll trials assess therapeutic benefit (usually involving a few hundred people, usually with controls, but not always);
- Phase III trials compare the new treatment against standard (or placebo) treatment (usually a full randomised controlled trial). At this point, a drug can be approved for community use.
- Phase IV monitors a new treatment in the community, often to evaluate longterm safety and effectiveness. [Glossary of Terms in The Cochrane Collaboration]

A trial can be of a combination phase (e.g., I/II).
The concept of phase is not applicable to trials studying certain interventions (e.g., device, procedure, behavioral)""" ;
                                                       <http://purl.obolibrary.org/obo/IAO_0000117> "Simona" ;
                                                       rdfs:label "Phase"@en .


###  http://purl.org/net/OCRe/study_design.owl#Phase_0
<http://purl.org/net/OCRe/study_design.owl#Phase_0> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> "A Phase 0 trial is an exploratory trial involving very limited human exposure, with no therapeutic or diagnostic intent (e.g., screening study, microdose study). [http://prsinfo.clinicaltrials.gov/definitions.html]" ;
                                                    <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                    rdfs:label "Phase 0"@en .


###  http://purl.org/net/OCRe/study_design.owl#Phase_1
<http://purl.org/net/OCRe/study_design.owl#Phase_1> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> "A Phase I trial assesses toxic effects on humans (not many people participate, and usually without controls) [Glossary of Terms in The Cochrane Collaboration]" ;
                                                    <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                    rdfs:label "Phase 1"@en .


###  http://purl.org/net/OCRe/study_design.owl#Phase_2
<http://purl.org/net/OCRe/study_design.owl#Phase_2> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> "A Phase ll trial assesses therapeutic benefit (usually involving a few hundred people, usually with controls, but not always) [Glossary of Terms in The Cochrane Collaboration]" ;
                                                    <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                    rdfs:label "Phase 2"@en .


###  http://purl.org/net/OCRe/study_design.owl#Phase_3
<http://purl.org/net/OCRe/study_design.owl#Phase_3> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> """A Phase III trial compares the new treatment against standard (or placebo) treatment (usually a full
randomised controlled trial). At this point, a drug can be approved for community use. [Glossary of Terms in The Cochrane Collaboration]""" ;
                                                    <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                    rdfs:label "Phase 3"@en .


###  http://purl.org/net/OCRe/study_design.owl#Phase_4
<http://purl.org/net/OCRe/study_design.owl#Phase_4> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ;
                                                    <http://purl.obolibrary.org/obo/IAO_0000115> "A Phase IV study monitors a new treatment in the community, often to evaluate longterm safety and effectiveness. [Glossary of Terms in The Cochrane Collaboration]" ;
                                                    <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                    rdfs:label "Phase 4"@en .


###  http://purl.org/net/OCRe/study_design.owl#Single_group_study
<http://purl.org/net/OCRe/study_design.owl#Single_group_study> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.org/net/OCRe/research.owl#Interventional_study> ;
                                                               <http://purl.obolibrary.org/obo/IAO_0000115> """A single group study is an interventional study that has only a single allocation group and no contemporaneuos comparison group.
A study in which an individual acts has his/her own comparison does not fall into this category, since an individual is not a group.""" ;
                                                               <http://purl.org/net/OCRe/statistics.owl#curator> "Simona" ;
                                                               <http://purl.org/net/OCRe/study_protocol.owl#develop_comment> "Simona: to be reviewed" ;
                                                               rdfs:label "Single Group Study"@en .


###  http://purl.org/ontology/bibo/AcademicArticle
<http://purl.org/ontology/bibo/AcademicArticle> rdf:type owl:Class ;
