                                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Person>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://vivoweb.org/ontology/core#dateTimeInterval> ;
                                                                          owl:allValuesFrom <http://vivoweb.org/ontology/core#DateTimeInterval>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://vivoweb.org/ontology/core#hasSubjectArea> ;
                                                                          owl:allValuesFrom owl:Thing
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A dual relationship of one person being advised or mentored by another person, typically including start and end dates" ;
                                                        rdfs:label "Advising Relationship"@en .


