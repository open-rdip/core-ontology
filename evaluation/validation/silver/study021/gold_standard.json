    "Method": [
      {
        "name": "Semantic Diversity-aware Prototype-based Learning (DPL)",
        "description": "A framework that learns regions in the semantic space covered by each predicate to distinguish among various semantics and achieve unbiased scene graph generation."
      },
      {
        "name": "Probabilistic Prototype Sampling",
        "description": "A method to represent the semantic diversity of a predicate by sampling from a distribution in the semantic space."
      },
      {
        "name": "Prototype-based Semantic Decoupling",
        "description": "A technique to distinguish different semantics of a single predicate using multiple prototypes."
      }
    ],
