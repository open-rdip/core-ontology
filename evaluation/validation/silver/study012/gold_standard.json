        "name": "Panoptic FPN",
        "description": "A single network that unifies instance and semantic segmentation by endowing Mask R-CNN with a semantic segmentation branch using a shared Feature Pyramid Network (FPN) backbone."
      },
      {
        "name": "Mask R-CNN",
        "description": "A popular instance segmentation method used as the base for the proposed panoptic framework."
      },
      {
        "name": "Feature Pyramid Network (FPN)",
        "description": "A backbone architecture that provides multi-scale, high-resolution features for both instance and semantic segmentation heads."
      },
      {
        "name": "Panoptic Segmentation",
        "description": "A joint task unifying instance segmentation for 'thing' classes and semantic segmentation for 'stuff' classes."
      }
