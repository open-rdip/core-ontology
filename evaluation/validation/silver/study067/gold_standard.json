    "Method": [
      {
        "name": "Agent-Specific Effect Shapley Value (ASE-SV)",
        "description": "A causal explanation formula that uses Shapley values to attribute the counterfactual effect of an agent's action to individual agents."
      },
      {
        "name": "Reduced Structure-Preserving State Effect (r-SSE)",
        "description": "A concept used to quantify the counterfactual effect of an agent's action that propagates through state transitions."
      },
      {
        "name": "r-SSE Integrated Causal Contribution (r-SSE-ICC)",
        "description": "A method to attribute scores to individual state variables reflecting their contribution to the counterfactual effect."
      }
    ],
