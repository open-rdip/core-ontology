        "name": "Denoising Autoencoder",
        "description": "A neural network trained to reconstruct original images from corrupted versions to learn robust feature representations."
      },
      {
        "name": "Anomaly Detection",
        "description": "The process of identifying rare items, events or observations which raise suspicions by differing significantly from the majority of the data."
      },
      {
        "name": "Reconstruction-based Anomaly Detection",
        "description": "Detecting anomalies by calculating the reconstruction error between the input image and the autoencoder output."
      },
      {
        "name": "Feature-based Anomaly Detection",
        "description": "Detecting anomalies using a classifier or distance metric applied to the latent features extracted by the autoencoder."
      }
