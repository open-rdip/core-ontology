    "Method": [
      {
        "name": "Patching",
        "description": "Segmentation of time series into subseries-level patches which are served as input tokens to Transformer."
      },
      {
        "name": "Channel-independence",
        "description": "Design where each channel contains a single univariate time series that shares the same embedding and Transformer weights."
      },
      {
        "name": "PatchTST",
        "description": "A Transformer-based model utilizing patching and channel-independence for multivariate time series forecasting."
      },
      {
        "name": "Masked Self-supervised Learning",
        "description": "A pre-training task where a portion of the input patches are masked and the model is trained to reconstruct them."
      }
