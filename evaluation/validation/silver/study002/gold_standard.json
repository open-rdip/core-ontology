    "Method": [
      {
        "name": "Kronecker Decomposition (KD)",
        "description": "A technique to reduce the number of parameters in a knowledge graph embedding model by splitting large embedding matrices into smaller ones during training."
      },
      {
        "name": "Link Prediction",
        "description": "The task of predicting whether a triple is likely to be true in a knowledge graph."
      },
      {
        "name": "Label Smoothing (LS)",
        "description": "An implicit calibration method that transforms probability distributions to less extreme ones to improve robustness."
      },
      {
        "name": "Label Relaxation (LR)",
        "description": "A generalization of label smoothing that models the target as a credal set of candidate probability distributions."
      },
      {
        "name": "1vsAll",
        "description": "A training strategy where for each positive triple, all possible tail perturbed triples are considered as negative examples."
      },
      {
        "name": "KvsAll",
        "description": "A training strategy that constructs multi-label binary vectors for each head-relation pair."
      }
    ],
