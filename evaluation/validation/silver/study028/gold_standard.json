    "Method": [
      {
        "name": "AnatPaste",
        "description": "An anatomy-aware pasting augmentation tool that uses a threshold-based lung segmentation pretext task to create anomalies in normal chest radiographs for model pretraining."
      },
      {
        "name": "Threshold-based Lung Segmentation",
        "description": "A method to automatically extract lung area from chest radiographs using pixel intensity thresholds."
      },
      {
        "name": "Self-supervised Learning (SSL)",
        "description": "A training method to learn data-specific features from unlabeled data through pretext tasks."
      }
