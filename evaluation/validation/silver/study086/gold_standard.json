    "Method": [
      {
        "name": "ProFLingo",
        "description": "A black-box fingerprinting-based IP protection scheme for LLMs that generates queries to elicit unique responses for establishing model ownership."
      },
      {
        "name": "Fingerprint Generation",
        "description": "Leveraging an LLM generator to create specialized queries that evoke low-probability responses from the target model."
      },
      {
        "name": "Fingerprint Verification",
        "description": "Using a hypothesis testing-based verification method to determine if a suspect model is a derivative of the original model."
      }
    ],
