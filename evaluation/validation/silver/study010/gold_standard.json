    "Method": [
      {
        "name": "SVTR",
        "description": "A single visual model for scene text recognition that dispenses with sequential modeling and uses a patch-wise image tokenization framework."
      },
      {
        "name": "Global Mixing",
        "description": "A mechanism that evaluates the dependence among all character components to establish long-term dependence."
      },
      {
        "name": "Local Mixing",
        "description": "A mechanism that evaluates correlation among components within a predefined window to encode character morphology."
      },
      {
        "name": "Progressive Overlapping Patch Embedding",
        "description": "A method to transform an image text into patches (character components) using consecutive 3x3 convolutions."
      },
      {
        "name": "Multi-Resolution Heatmap Aggregation",
        "description": "A strategy used during inference to generate scale-aware high-resolution heatmaps."
      }
    ],
