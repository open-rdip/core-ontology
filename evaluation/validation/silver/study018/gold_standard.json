    "Method": [
      {
        "name": "RetinaMask",
        "description": "An augmented single-shot detector that improves RetinaNet by integrating instance mask prediction, an adaptive loss function, and additional hard examples during training."
      },
      {
        "name": "Self-adjusting Loss",
        "description": "An adaptive loss function for bounding box regression that starts as Smooth L1 loss and transitions based on the current state of training."
      },
      {
        "name": "Best-Matching-Prior",
        "description": "A training strategy that ensures every ground truth object is matched to at least one anchor, even if the overlap is low."
      },
      {
        "name": "Mask Prediction Module",
        "description": "A module added during training to predict instance masks, which helps the network learn better feature representations for detection."
      }
    ],
