        "name": "Hard Sample Aware Network (HSAN)",
        "description": "A contrastive deep graph clustering method that introduces a comprehensive similarity measure for hard sample mining."
      },
      {
        "name": "Similarity-based Hard Sample Mining",
        "description": "A technique to weight sample pairs based on attribute-structure similarity to enhance discriminative capability."
      },
      {
        "name": "Contrastive Learning",
        "description": "A mechanism to learn representations by pulling positive pairs together and pushing negative pairs apart."
