    "Method": [
      {
        "name": "H3DNet",
        "description": "An end-to-end neural network that predicts a hybrid and overcomplete set of geometric primitives to detect and refine 3D object bounding boxes."
      },
      {
        "name": "Hybrid Geometric Primitives Prediction",
        "description": "Predicting BB centers, BB face centers, and BB edge centers to provide accurate signals for object detection."
      },
      {
        "name": "Parametric Distance Function Optimization",
        "description": "Defining a distance function between an object and geometric primitives to enable continuous optimization of object proposals."
      },
      {
        "name": "Matching and Refinement Module",
        "description": "A module to classify object proposals and fine-tune geometric parameters and semantic labels."
      }
