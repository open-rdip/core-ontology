    "Method": [
      {
        "name": "Attentive Squeeze Network (ASNet)",
        "description": "A model that leverages deep semantic correlation and global self-attention to construct class-wise foreground maps for multi-label classification and pixel-wise segmentation."
      },
      {
        "name": "Integrative Few-Shot Learning (iFSL)",
        "description": "A framework for the integrative task of few-shot classification and segmentation that trains a learner to construct class-wise foreground maps."
      },
      {
        "name": "Deep Semantic Correlation",
        "description": "A method to compute the similarity between support and query features to identify potential object regions."
      }
