    "Method": [
      {
        "name": "Truncated Emphatic TD",
        "description": "An off-policy prediction algorithm using truncated followon traces to reduce variance and enable finite sample analysis."
      },
      {
        "name": "Truncated Emphatic Expected SARSA",
        "description": "An off-policy control algorithm that employs truncated followon traces for action-value estimation."
      },
      {
        "name": "Projected Truncated Emphatic TD",
        "description": "A variant of Truncated Emphatic TD that uses a projection operator to maintain parameter boundedness during finite sample analysis."
      },
      {
        "name": "Soft Truncation (ETD(0, beta))",
        "description": "An existing method for variance reduction in emphatic TD that uses a hyperparameter to trade off bias and variance."
      }
