    "Method": [
      {
        "name": "BEVDepth",
        "description": "A 3D object detector for camera-based Bird's-Eye-View detection that leverages explicit depth supervision and a camera-awareness depth estimation module."
      },
      {
        "name": "Camera-awareness Depth Prediction",
        "description": "A module that uses camera intrinsic and extrinsic parameters as input to facilitate depth predicting capability."
      },
      {
        "name": "Depth Refinement Module",
        "description": "A module designed to counter side effects of imprecise feature unprojection using residual blocks."
      },
      {
        "name": "Efficient Voxel Pooling",
        "description": "A customized GPU-based operator for fast conversion of multi-view features into BEV space."
      }
    ],
