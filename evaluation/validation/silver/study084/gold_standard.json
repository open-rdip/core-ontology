    "Method": [
      {
        "name": "ALign Before Fuse (ALBEF)",
        "description": "A contrastive loss used to align image and text representations before fusing them through cross-modal attention."
      },
      {
        "name": "Momentum Distillation",
        "description": "A self-training method that learns from pseudo-targets produced by a momentum model to improve learning from noisy web data."
      },
      {
        "name": "Image-Text Contrastive Learning (ITC)",
        "description": "A method to align the unimodal representations of image and text."
      },
      {
        "name": "Masked Language Modeling (MLM)",
        "description": "A task that utilizes both the image and the contextual text to predict masked words."
      },
      {
        "name": "Image-Text Matching (ITM)",
        "description": "A task that predicts whether a pair of image and text is matched or not."
      }
