        "name": "Swin Transformer",
        "description": "A hierarchical vision Transformer whose representation is computed with shifted windows to achieve linear computational complexity."
      },
      {
        "name": "Shifted Windowing Scheme",
        "description": "A method that limits self-attention computation to non-overlapping local windows while allowing for cross-window connection."
      },
      {
        "name": "Hierarchical Feature Map",
        "description": "The construction of hierarchical representations by merging image patches in deeper layers."
