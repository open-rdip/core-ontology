    "Method": [
      {
        "name": "MOL",
        "description": "An end-to-end deep learning framework that jointly estimates micro-expressions, optical flow, and facial landmarks using transformer-graph-style convolution."
      },
      {
        "name": "F5C block",
        "description": "A block composed of fully-connected convolution and channel correspondence convolution to extract local-global features from raw frames."
      },
      {
        "name": "Channel correspondence convolution",
        "description": "A graph-style convolution introduced to model correlations among feature patterns."
