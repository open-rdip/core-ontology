    "Method": [
      {
        "name": "Binary Passage Retriever (BPR)",
        "description": "A memory-efficient neural retrieval model that integrates learning-to-hash into Dense Passage Retriever to represent the passage index using binary codes."
      },
      {
        "name": "Dense Passage Retriever (DPR)",
        "description": "A state-of-the-art retrieval model that encodes passages into continuous vectors."
      },
      {
        "name": "Learning-to-hash",
        "description": "A technique used to map high-dimensional data into compact binary codes while preserving similarity."
      }
