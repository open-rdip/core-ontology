    "Method": [
      {
        "name": "Basin-hopping",
        "description": "A global optimization technique that transforms the potential energy surface into a collection of interpenetrating staircases by associating any point with its local minimum."
      },
      {
        "name": "Monte Carlo",
        "description": "Used for exploring the transformed energy landscape via a series of random steps and an acceptance criterion."
      },
      {
        "name": "Conjugate Gradient",
        "description": "A local optimization method used to find the nearest minimum in the configuration space."
