ex:study003_Method1 a rdip:Method ;
    rdip:title "Camouflage-Aware Feature Refinement (CAFR)" ;
    rdip:description "A fine-tuning strategy utilizing prior knowledge of large models to understand distinctions between background and foreground in RCOD tasks." ;
    .
ex:study003_Method2 a rdip:Method ;
    rdip:title "Adaptive Gradient Propagation (AGP)" ;
    rdip:description "A module that fine-tunes all feature extractor layers by restricting the proportion of gradient return to refine class-specific features." ;
    .
ex:study003_Method3 a rdip:Method ;
    rdip:title "Sparse Feature Refinement (SFR)" ;
    rdip:description "A module that optimizes transformer-based feature extractors by reducing the size of camouflaged objects to focus on local class-specific features." ;
    .

