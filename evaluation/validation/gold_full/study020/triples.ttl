ex:study020_Method1 a rdip:Method ;
    rdip:title "Ordinal Classification" ;
    rdip:description "A classification task where the classes have a natural order, used here to assess levels of mammographic masking." ;
    .
ex:study020_Method2 a rdip:Method ;
    rdip:title "Deep Learning Regression" ;
    rdip:description "Training convolutional neural networks to estimate the masking level of mammograms as a continuous value." ;
    .
ex:study020_Method3 a rdip:Method ;
    rdip:title "Majority Voting" ;
    rdip:description "Combining multiple specialist annotations to form a consensus ground truth." ;
    .

