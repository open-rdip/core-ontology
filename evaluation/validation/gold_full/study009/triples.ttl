ex:study009_Method1 a rdip:Method ;
    rdip:title "HigherHRNet" ;
    rdip:description "A novel bottom-up human pose estimation method for learning scale-aware representations using high-resolution feature pyramids." ;
    .
ex:study009_Method2 a rdip:Method ;
    rdip:title "Multi-Resolution Supervision" ;
    rdip:description "A strategy to assign training targets of different resolutions to corresponding feature pyramid levels to handle scale variation." ;
    .
ex:study009_Method3 a rdip:Method ;
    rdip:title "Multi-Resolution Heatmap Aggregation" ;
    rdip:description "A strategy used during inference to generate scale-aware high-resolution heatmaps by aggregating multiple resolutions." ;
    .
ex:study009_Method4 a rdip:Method ;
    rdip:title "Associative Embedding" ;
    rdip:description "A grouping method that clusters identity-free keypoints into individuals by grouping keypoints whose tags have small l2 distance." ;
    .
ex:study009_Method5 a rdip:Method ;
    rdip:title "Deconvolution Module" ;
    rdip:description "A module used to generate high quality feature maps whose resolution is two times higher than the input feature maps." ;
    .

