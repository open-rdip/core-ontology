    "Method": [
      {
        "name": "HigherHRNet",
        "description": "A novel bottom-up human pose estimation method for learning scale-aware representations using high-resolution feature pyramids."
      },
      {
        "name": "Multi-Resolution Supervision",
        "description": "A strategy to assign training targets of different resolutions to corresponding feature pyramid levels to handle scale variation."
      },
      {
        "name": "Multi-Resolution Heatmap Aggregation",
        "description": "A strategy used during inference to generate scale-aware high-resolution heatmaps by aggregating multiple resolutions."
      },
      {
        "name": "Associative Embedding",
        "description": "A grouping method that clusters identity-free keypoints into individuals by grouping keypoints whose tags have small l2 distance."
      },
      {
        "name": "Deconvolution Module",
        "description": "A module used to generate high quality feature maps whose resolution is two times higher than the input feature maps."
      }
    ],
