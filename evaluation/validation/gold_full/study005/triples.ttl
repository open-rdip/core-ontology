ex:study005_Method1 a rdip:Method ;
    rdip:title "Ensemble of Expert Denoisers" ;
    rdip:description "Training specialized diffusion models for different stages of the iterative generation process to improve text alignment and visual quality." ;
    .
ex:study005_Method2 a rdip:Method ;
    rdip:title "Paint-with-Words" ;
    rdip:description "A technique allowing users to select words in a prompt and paint them on a canvas to control the specific spatial layout of objects." ;
    .
ex:study005_Method3 a rdip:Method ;
    rdip:title "Binary-tree-based branching strategy" ;
    rdip:description "A progressive training schedule where a single model is split into specialized models for specific noise level intervals." ;
    .
ex:study005_Method4 a rdip:Method ;
    rdip:title "Classifier-free guidance" ;
    rdip:description "A method to guide the diffusion process toward the conditioning signal without training a separate classifier." ;
    .

