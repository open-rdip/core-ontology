ex:study017_Method1 a rdip:Method ;
    rdip:title "Vahadane Normalization" ;
    rdip:description "A stain normalization technique used during preprocessing to standardize the appearance of histopathology images." ;
    .
ex:study017_Method2 a rdip:Method ;
    rdip:title "Macenko Normalization" ;
    rdip:description "A method for stain normalization based on singular value decomposition of the optical density transformation." ;
    .
ex:study017_Method3 a rdip:Method ;
    rdip:title "Cell Graph (CG) Construction" ;
    rdip:description "Representing tissue by detecting nuclei as nodes and defining edges based on spatial proximity or connectivity." ;
    .
ex:study017_Method4 a rdip:Method ;
    rdip:title "Tissue Graph (TG) Construction" ;
    rdip:description "Representing tissue by detecting super-pixels or regions as nodes to capture higher-level architectural patterns." ;
    .

