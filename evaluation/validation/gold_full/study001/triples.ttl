ex:study001_Method1 a rdip:Method ;
    rdip:title "Round-to-nearest (RTN)" ;
    rdip:description "A naive baseline quantization method that rounds floating point numbers to the nearest integer representation." ;
    .
ex:study001_Method2 a rdip:Method ;
    rdip:title "GPTQ" ;
    rdip:description "A post-training quantization method that updates weights by solving a non-linear least square problem layer-by-layer." ;
    .
ex:study001_Method3 a rdip:Method ;
    rdip:title "ZeroQuant (ZQ-Global)" ;
    rdip:description "A method that treats each layer as a subnetwork and uses distillation to optimize the quantized version." ;
    .
ex:study001_Method4 a rdip:Method ;
    rdip:title "Low-Rank Compensation (LoRC)" ;
    rdip:description "A technique that uses low-rank matrix factorization to compensate for quantization errors in weights." ;
    .

