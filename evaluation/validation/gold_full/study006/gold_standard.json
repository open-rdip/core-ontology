    "Method": [
      {
        "name": "Latent Macro Action Planner (L-MAP)",
        "description": "A method that learns a set of temporally extended macro-actions through a state-conditional VQ-VAE and uses Monte Carlo tree search for planning."
      },
      {
        "name": "Vector Quantized Variational Autoencoder (VQ-VAE)",
        "description": "A model used to learn a lower-dimensional discrete representation of temporally extended primitive actions (macro-actions)."
      },
      {
        "name": "Monte Carlo Tree Search (MCTS)",
        "description": "A search algorithm used to navigate the latent space, integrated with progressive widening to address environment and behavior policy stochasticity."
      },
      {
        "name": "Progressive Widening",
        "description": "A strategy used with MCTS to balance rapid planning using learned abstractions with exhaustive exploration when resources permit."
      },
      {
        "name": "Polling Control Mode",
        "description": "A mode where MCTS returns only the first primitive action of the recommended macro-action, allowing for recovery from locally suboptimal decisions."
      }
    ],
