ex:study002_Method1 a rdip:Method ;
    rdip:title "Kronecker Decomposition (KD)" ;
    rdip:description "A technique to reduce the number of parameters in a knowledge graph embedding model by splitting large embedding matrices into smaller ones during training." ;
    .
ex:study002_Method2 a rdip:Method ;
    rdip:title "Link Prediction" ;
    rdip:description "The task of predicting whether a triple is likely to be true in a knowledge graph." ;
    .
ex:study002_Method3 a rdip:Method ;
    rdip:title "Label Smoothing (LS)" ;
    rdip:description "An implicit calibration method that transforms probability distributions to less extreme ones to improve robustness." ;
    .
ex:study002_Method4 a rdip:Method ;
    rdip:title "Label Relaxation (LR)" ;
    rdip:description "A generalization of label smoothing that models the target as a credal set of candidate probability distributions." ;
    .
ex:study002_Method5 a rdip:Method ;
    rdip:title "1vsAll" ;
    rdip:description "A training strategy where for each positive triple, all possible tail perturbed triples are considered as negative examples." ;
    .
ex:study002_Method6 a rdip:Method ;
    rdip:title "KvsAll" ;
    rdip:description "A training strategy that constructs multi-label binary vectors for each head-relation pair." ;
    .

