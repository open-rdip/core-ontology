ex:study022_Method1 a rdip:Method ;
    rdip:title "TransAct" ;
    rdip:description "A sequential model based on a Transformer architecture that extracts users' short-term preferences from their realtime activities for recommendation." ;
    .
ex:study022_Method2 a rdip:Method ;
    rdip:title "End-to-end sequential modeling" ;
    rdip:description "A method to learn user representations directly from raw action sequences during the ranking process." ;
    .
ex:study022_Method3 a rdip:Method ;
    rdip:title "Hybrid ranking approach" ;
    rdip:description "A technique combining end-to-end sequential modeling with batch-generated user embeddings to capture both short-term and long-term interests." ;
    .

