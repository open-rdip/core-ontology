ex:study008_Method1 a rdip:Method ;
    rdip:title "Pure bfloat16 training" ;
    rdip:description "Training without full-precision optimizer states or a model weight copy to reduce memory usage and increase speed on limited GPUs." ;
    .
ex:study008_Method2 a rdip:Method ;
    rdip:title "Tokenizer Swapping" ;
    rdip:description "Replacing a base model's tokenizer with a specialized one for a target language to improve fertility and training efficiency." ;
    .
ex:study008_Method3 a rdip:Method ;
    rdip:title "Continued Pretraining" ;
    rdip:description "Adapting an existing LLM to a target language by further training on domain-specific or language-specific corpora." ;
    .
ex:study008_Method4 a rdip:Method ;
    rdip:title "Embedding Initialization" ;
    rdip:description "A technique to initialize new embeddings for a swapped tokenizer based on existing embeddings to facilitate faster re-learning." ;
    .

