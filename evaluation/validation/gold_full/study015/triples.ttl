ex:study015_Method1 a rdip:Method ;
    rdip:title "Fixed-stress approximation" ;
    rdip:description "An extension to account for both the porous media and fracture subdomains to decouple the momentum balance." ;
    .
ex:study015_Method2 a rdip:Method ;
    rdip:title "Constrained Pressure Residual (CPR)" ;
    rdip:description "A two-stage approach to treat the coupling between fluid flow and transport." ;
    .
ex:study015_Method3 a rdip:Method ;
    rdip:title "System-AMG approach" ;
    rdip:description "Applying the Algebraic Multigrid method to the monolithic pressure-temperature submatrix." ;
    .
ex:study015_Method4 a rdip:Method ;
    rdip:title "Discrete fracture-matrix (DFM) modeling" ;
    rdip:description "An approach where fractures and their intersections are represented explicitly as lower-dimensional geometrical objects." ;
    .

