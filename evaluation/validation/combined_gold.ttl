ex:study006_Method1 a rdip:Method ;
    rdip:title "Latent Macro Action Planner (L-MAP)" ;
    rdip:description "A method that learns a set of temporally extended macro-actions through a state-conditional VQ-VAE and uses Monte Carlo tree search for planning." ;
    .
ex:study006_Method2 a rdip:Method ;
    rdip:title "Vector Quantized Variational Autoencoder (VQ-VAE)" ;
    rdip:description "A model used to learn a lower-dimensional discrete representation of temporally extended primitive actions (macro-actions)." ;
    .
ex:study006_Method3 a rdip:Method ;
    rdip:title "Monte Carlo Tree Search (MCTS)" ;
    rdip:description "A search algorithm used to navigate the latent space, integrated with progressive widening to address environment and behavior policy stochasticity." ;
    .
ex:study006_Method4 a rdip:Method ;
    rdip:title "Progressive Widening" ;
    rdip:description "A strategy used with MCTS to balance rapid planning using learned abstractions with exhaustive exploration when resources permit." ;
    .
ex:study006_Method5 a rdip:Method ;
    rdip:title "Polling Control Mode" ;
    rdip:description "A mode where MCTS returns only the first primitive action of the recommended macro-action, allowing for recovery from locally suboptimal decisions." ;
    .

