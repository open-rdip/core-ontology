    "Method": [
      {
        "name": "Pure bfloat16 training",
        "description": "Training without full-precision optimizer states or a model weight copy to reduce memory usage and increase speed on limited GPUs."
      },
      {
        "name": "Tokenizer Swapping",
        "description": "Replacing a base model's tokenizer with a specialized one for a target language to improve fertility and training efficiency."
      },
      {
        "name": "Continued Pretraining",
        "description": "Adapting an existing LLM to a target language by further training on domain-specific or language-specific corpora."
      },
      {
        "name": "Embedding Initialization",
        "description": "A technique to initialize new embeddings for a swapped tokenizer based on existing embeddings to facilitate faster re-learning."
      }
    ],
