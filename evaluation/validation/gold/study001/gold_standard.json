    "Method": [
      {
        "name": "Round-to-nearest (RTN)",
        "description": "A naive baseline quantization method that rounds floating point numbers to the nearest integer representation."
      },
      {
        "name": "GPTQ",
        "description": "A post-training quantization method that updates weights by solving a non-linear least square problem layer-by-layer."
      },
      {
        "name": "ZeroQuant (ZQ-Global)",
        "description": "A method that treats each layer as a subnetwork and uses distillation to optimize the quantized version."
      },
      {
        "name": "Low-Rank Compensation (LoRC)",
        "description": "A technique that uses low-rank matrix factorization to compensate for quantization errors in weights."
      }
