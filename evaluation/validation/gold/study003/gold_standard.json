    "Method": [
      {
        "name": "Camouflage-Aware Feature Refinement (CAFR)",
        "description": "A fine-tuning strategy utilizing prior knowledge of large models to understand distinctions between background and foreground in RCOD tasks."
      },
      {
        "name": "Adaptive Gradient Propagation (AGP)",
        "description": "A module that fine-tunes all feature extractor layers by restricting the proportion of gradient return to refine class-specific features."
      },
      {
        "name": "Sparse Feature Refinement (SFR)",
        "description": "A module that optimizes transformer-based feature extractors by reducing the size of camouflaged objects to focus on local class-specific features."
      }
    ],
